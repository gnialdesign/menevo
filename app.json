{
  "expo": {
    "name": "Men's Evolution",
    "slug": "mens-evolution",
    "scheme": "mensevolution",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "plugins": [
      "expo-router",
      [
        "expo-notifications",
        {
          "enableRemoteNotifications": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Permita o acesso às fotos para escolher uma imagem para sua análise visual.",
          "cameraPermission": "Permita o acesso à câmera para tirar uma foto para sua análise visual.",
          "microphonePermission": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.mensevolution.app"
    },
    "android": {
      "package": "com.mensevolution.app",
      "adaptiveIcon": {
        "backgroundColor": "#151719"
      }
    },
    "web": {
      "bundler": "metro"
    }
  }
}
